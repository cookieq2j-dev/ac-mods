import tkinter as tk
from tkinter import ttk

class Item:
    def __init__(self, id, name, category):
        self.id = id
        self.name = name
        self.category = category

class ItemBrowser:
    def __init__(self, root):
        self.root = root
        self.root.title("The Honored One")
        self.root.geometry("800x800")

        # UI Elements
        self.search_box = tk.Entry(self.root)
        self.search_box.pack(fill=tk.X, padx=10, pady=5)
        self.search_box.insert(0, "Search items...")
        self.search_box.bind('<KeyRelease>', self.filter_items)

        self.slider_label = tk.Label(self.root, text="Max items to show: 0")
        self.slider_label.pack(pady=5)

        self.item_limit_slider = ttk.Scale(self.root, from_=1, to=0, orient='horizontal')
        self.item_limit_slider.pack(fill=tk.X, padx=10, pady=5)
        self.item_limit_slider.bind("<Motion>", self.update_slider)

        self.notebook = ttk.Notebook(self.root)
        self.notebook.pack(fill=tk.BOTH, expand=True)

        self.info_label = tk.Label(self.root, text="", bg="black", fg="yellow", height=2)
        self.info_label.pack(fill=tk.X, padx=10)

        # Load items
        self.load_items()
        self.item_limit_slider.config(to=len(self.items), value=len(self.items))
        self.max_items_to_show = len(self.items)
        self.slider_label.config(text=f"Max items to show: {self.max_items_to_show}")
        self.build_tabs()

