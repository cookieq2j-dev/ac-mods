        seen = set()
        self.items = []
        for item in all_items:
            if item.name not in seen:
                seen.add(item.name)
                self.items.append(item)

    def build_tabs(self):
        for tab in self.notebook.tabs():
            self.notebook.forget(tab)

        search = self.search_box.get().lower()
        categories = {item.category for item in self.items}

        for cat in categories:
            tab = ttk.Frame(self.notebook)
            self.notebook.add(tab, text=cat)

            filtered_items = [item for item in self.items if item.category == cat and search in item.name.lower()][:self.max_items_to_show]
            for item in filtered_items:
                btn = tk.Button(tab, text=item.name, width=20, command=lambda item=item: self.spawn_item(item))
                btn.pack(pady=2)

    def spawn_item(self, item):
        self.info_label.config(text=f"Spawned: {item.name} (ID: {item.id})")

    def update_slider(self, event):
        self.max_items_to_show = int(self.item_limit_slider.get())
        self.slider_label.config(text=f"Max items to show: {self.max_items_to_show}")
        self.build_tabs()

    def filter_items(self, event):
        self.build_tabs()

